---
import Layout from './Layout.astro';
import type { MarkdownHeading } from 'astro';
import '../styles/articles.css';

interface Props {
  title: string;
  description: string;
  category: string;
  headings: MarkdownHeading[];
}
const { title, description, category, headings } = Astro.props;
const sections = headings.filter(heading => heading.depth === 2);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={`${title} — CABE`} description={description}>
  <main class="page article-page" id="main" tabindex="-1">
    <header class="page__header">
      <div class="container">
        <a class="section-label" href={`${base}/articles/`}>Articles</a>
        <p class="article-category">{category}</p>
        <h1 class="page__title">{title}</h1>
        <p class="page__subtitle">{description}</p>
      </div>
    </header>
    <div class:list={['container', 'article-layout', { 'article-layout--without-contents': sections.length === 0 }]}>
      {sections.length > 0 && <nav class="article-contents" aria-label="Article contents">
        <h2>In this article</h2>
        <ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
      </nav>}
      <article class="article-prose" aria-label={title}>
        <slot />
        <p class="article-return"><a href={`${base}/articles/`}>← All articles</a></p>
      </article>
    </div>
  </main>
</Layout>
