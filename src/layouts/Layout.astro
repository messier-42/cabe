---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CABE — Concise Attribute-Bound Encapsulation',
  description = 'CABE: an encrypted message format and policy controlled key access for distributed applications.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href={`${base}/favicon-32.png`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} sizes="any" />
    <title>{title}</title>
    <noscript>
      <style is:global>
        #load-simulator, .copy-button { display: none !important; }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
