---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CABE — Concise Attribute-Bound Encapsulation',
  description = 'A modern, compact encryption standard for fine-grained access control.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=Syne:wght@700;800&family=Orbitron:wght@500;700;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <footer class="footer">
      <div class="container footer__inner">
        <div class="footer__left">
          <span class="footer__logo">CABE</span>
          <p class="footer__copy">
          </p>
        </div>
        <div class="footer__links">
          <a href="/game/">Interactive Policy Simulator</a>
          <a href={`${base}/specification`}>Specification</a>
          <a href={`${base}/software`}>Software</a>
          <a href={`${base}/faq`}>FAQ</a>
          <a href={`${base}/get-involved`}>Get Involved</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    /* Light palette */
    --bg:           #f7f5f0;
    --bg-1:         #ffffff;
    --bg-2:         #f0ede6;
    --bg-3:         #e8e3da;
    --bg-4:         #ddd8cc;

    --ink:          #000000;
    --ink-1:        #000000;
    --ink-2:        #000000;
    --ink-3:        #000000;
    --ink-4:        #000000;

    --border:       #d4cfc5;
    --border-dim:   #e5e1d8;

    --amber:        #b86c00;
    --amber-bright: #d07a00;
    --amber-dim:    #8a5000;
    --amber-trace:  #fdf0e0;
    --amber-border: #e8c080;

    --danger:       #c03030;
    --success:      #1a8a60;

    --font-display: sans-serif;
    --font-mono:    monospace;
    --font-body:    Verdana, Arial, sans-serif;

    --max-w: 1200px;
    --section-pad: clamp(5rem, 10vw, 9rem);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  ::selection {
    background: var(--amber-border);
    color: var(--ink);
  }

  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg-2); }
  ::-webkit-scrollbar-thumb { background: var(--amber-border); border-radius: 3px; }

  a {
    color: var(--amber);
    text-decoration: none;
  }
  a:hover { color: var(--amber-bright); }

  .container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 3rem);
  }

  /* ─── NAV ─────────────────────────────────────────────────── */
  .nav {
    position: static;
    border-bottom: 1px solid var(--border);
    background: var(--bg-1);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }

  .nav__logo {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .nav__logo-mark {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--amber);
    letter-spacing: 0.08em;
  }

  .nav__logo-sub {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-4);
    letter-spacing: 0.04em;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }

  .nav__link {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-3);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .nav__link:hover { color: var(--ink); }
  .nav__link--active {
    color: var(--amber);
    border-bottom: 2px solid var(--amber);
    padding-bottom: 2px;
  }

  .nav__cta {
    padding: 0.4rem 1rem !important;
    background: var(--amber-trace) !important;
    border: 1px solid var(--amber-border) !important;
    border-radius: 4px !important;
    color: var(--amber) !important;
    white-space: nowrap;
    transition: background 0.2s, border-color 0.2s !important;
  }
  .nav__cta:hover {
    background: #fde8c0 !important;
    border-color: var(--amber) !important;
    color: var(--amber-dim) !important;
  }

  /* Disclosure menu — appears once any inline link starts overflowing */
  .nav__menu { display: none; position: relative; }
  .nav__menu > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg-1);
    transition: border-color 0.2s, background 0.2s;
  }
  .nav__menu > summary::-webkit-details-marker { display: none; }
  .nav__menu > summary::marker { content: ''; }
  .nav__menu > summary:hover {
    border-color: var(--amber-border);
    background: var(--amber-trace);
  }
  .nav__menu-bar {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--ink-2);
    border-radius: 1px;
    transition: background 0.2s;
  }
  .nav__menu[open] > summary .nav__menu-bar { background: var(--amber); }

  .nav__menu-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 14rem;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
    z-index: 50;
  }

  .nav__menu-link {
    display: block;
    padding: 0.65rem 0.85rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-2);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition: background 0.15s, color 0.15s;
  }
  .nav__menu-link:hover {
    background: var(--bg-3);
    color: var(--ink);
  }
  .nav__menu-link--active {
    color: var(--amber);
  }
  .nav__menu-link--cta {
    margin-top: 0.25rem;
    border-top: 1px solid var(--border-dim);
    padding-top: 0.85rem;
    color: var(--amber);
  }

  /* ─── HERO ────────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding-top: clamp(5rem, 12vw, 10rem);
    padding-bottom: clamp(4rem, 10vw, 8rem);
    overflow: hidden;
    min-height: calc(100svh - 3.5rem);
    display: flex;
    align-items: center;
    background: var(--bg);
  }

  .hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border-dim) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-dim) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.7;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 40%, black 30%, transparent 100%);
  }

  .hero__circuit {
    position: absolute;
    top: 0; right: -5%;
    width: 55%;
    height: 100%;
    opacity: 0.5;
    pointer-events: none;
  }

  .hero__circuit svg { width: 100%; height: 100%; }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 780px;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--amber-border);
    border-radius: 100px;
    background: var(--amber-trace);
    margin-bottom: 2.5rem;
    animation: fadeUp 0.6s ease both;
  }

  .hero__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
    animation: pulse 2s ease-in-out infinite;
  }

  .hero__badge-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--amber);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 2rem;
  }

  .hero__title-line { display: block; }

  .hero__title-line--1 {
    color: var(--ink);
    animation: fadeUp 0.7s 0.1s ease both;
  }
  .hero__title-line--2 {
    color: var(--ink-2);
    animation: fadeUp 0.7s 0.2s ease both;
  }
  .hero__title-line--3 {
    color: var(--amber);
    animation: fadeUp 0.7s 0.3s ease both;
  }

  .hero__sub-row {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    animation: fadeUp 0.7s 0.4s ease both;
  }

  .hero__mono-tag {
    flex-shrink: 0;
    padding: 0.25rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--amber);
    background: var(--amber-trace);
    border: 1px solid var(--amber-border);
    border-radius: 3px;
    margin-top: 0.25rem;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--ink-3);
    line-height: 1.6;
    max-width: 520px;
    font-weight: 300;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 4rem;
    animation: fadeUp 0.7s 0.5s ease both;
  }

  .hero__metrics {
    display: flex;
    align-items: center;
    gap: 2rem;
    animation: fadeUp 0.7s 0.6s ease both;
  }

  .hero__metric {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero__metric-value {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--amber);
    line-height: 1;
  }

  .hero__metric-label {
    font-size: 0.7rem;
    color: var(--ink-4);
    max-width: 14ch;
    line-height: 1.3;
  }

  .hero__metric-divider {
    width: 1px;
    height: 3rem;
    background: var(--border);
    flex-shrink: 0;
  }

  /* ─── BUTTONS ─────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.75rem;
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
  }

  .btn--primary {
    background: var(--amber);
    color: #fff;
    font-weight: 700;
  }
  .btn--primary:hover {
    background: var(--amber-bright);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(184, 108, 0, 0.25);
  }

  .btn--ghost {
    background: transparent;
    color: var(--ink-2);
    border: 1px solid var(--border);
  }
  .btn--ghost:hover {
    border-color: var(--ink-4);
    color: var(--ink);
    background: var(--bg-3);
  }

  .btn--lg {
    padding: 0.9rem 2.25rem;
    font-size: 1rem;
  }

  /* ─── SECTION COMMON ──────────────────────────────────────── */
  .section-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber-dim);
    margin-bottom: 1.25rem;
  }

  .section-header {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    color: var(--ink);
  }
  .section-heading em {
    font-style: normal;
    color: var(--amber);
  }

  /* ─── OVERVIEW ────────────────────────────────────────────── */
  .overview {
    padding: var(--section-pad) 0;
    border-top: 1px solid var(--border);
    background: var(--bg-1);
  }

  .overview__inner {
    display: grid;
    gap: 4rem;
  }

  .overview__heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    margin-bottom: 2rem;
    color: var(--ink);
  }
  .overview__heading em {
    font-style: italic;
    color: var(--amber);
  }

  .overview__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .overview__col p {
    color: var(--ink-3);
    line-height: 1.8;
    font-weight: 300;
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
  }
  .overview__col p em {
    color: var(--ink);
    font-style: normal;
  }

  .overview__comparison {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    align-items: center;
  }

  .comparison-card {
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .comparison-card--before {
    background: var(--bg-2);
    opacity: 0.85;
  }

  .comparison-card--after {
    background: var(--bg-1);
    border-color: var(--amber-border);
    box-shadow: 0 0 40px rgba(184, 108, 0, 0.06);
  }

  .comparison-card__header {
    margin-bottom: 1.25rem;
  }

  .comparison-card__tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
  }

  .tag--muted { background: var(--bg-3); color: var(--ink-4); }
  .tag--amber { background: var(--amber-trace); color: var(--amber); border: 1px solid var(--amber-border); }

  .comparison-list { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
  .comparison-list__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--ink-3);
  }
  .comparison-list__item::before {
    content: '';
    width: 16px;
    height: 16px;
    border-radius: 50%;
    flex-shrink: 0;
    background-size: 10px 10px;
    background-position: center;
    background-repeat: no-repeat;
  }
  .comparison-list__item--no::before {
    background-color: rgba(192, 48, 48, 0.1);
    border: 1px solid rgba(192, 48, 48, 0.3);
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 10 10' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M2 2l6 6M8 2l-6 6' stroke='%23c03030' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
  }
  .comparison-list__item--yes::before {
    background-color: rgba(26, 138, 96, 0.1);
    border: 1px solid rgba(26, 138, 96, 0.3);
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 10 10' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1.5 5l2.5 2.5 4.5-5' stroke='%231a8a60' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  }

  .comparison-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
  }
  .comparison-divider__arrow {
    font-size: 1.5rem;
    color: var(--amber);
    font-family: var(--font-mono);
  }

  /* ─── FEATURES ────────────────────────────────────────────── */
  .features {
    padding: var(--section-pad) 0;
    background: var(--bg-2);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .feature-card {
    background: var(--bg-1);
    padding: 2rem 2rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: background 0.25s;
    position: relative;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--amber);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .feature-card:hover { background: var(--amber-trace); }
  .feature-card:hover::before { opacity: 1; }

  .feature-card__icon {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--amber);
  }
  .feature-card__icon svg { width: 100%; height: 100%; }

  .feature-card__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }

  .feature-card__body {
    font-size: 0.875rem;
    color: var(--ink-3);
    line-height: 1.7;
    flex: 1;
    font-weight: 300;
  }

  .feature-card__tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber-dim);
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
    margin-top: auto;
  }

  /* ─── MECHANISM ───────────────────────────────────────────── */
  .mechanism {
    padding: var(--section-pad) 0;
    background: var(--bg-1);
    border-bottom: 1px solid var(--border);
  }

  .mechanism__flow {
    display: flex;
    align-items: flex-start;
    gap: 0;
    margin-bottom: 4rem;
  }

  .mech-step {
    flex: 1;
    padding: 2rem;
    border: 1px solid var(--border);
    border-right: none;
    background: var(--bg);
    position: relative;
  }
  .mech-step:first-child { border-radius: 8px 0 0 8px; }
  .mech-step:last-child { border-right: 1px solid var(--border); border-radius: 0 8px 8px 0; }

  .mech-connector { width: 0; flex-shrink: 0; }

  .mech-step__number {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--amber);
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .mech-step__number::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--amber-border);
    opacity: 0.5;
  }

  .mech-step__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }

  .mech-step__body {
    font-size: 0.825rem;
    color: var(--ink-3);
    line-height: 1.7;
    font-weight: 300;
    margin-bottom: 1.25rem;
  }

  .mech-step__body code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--amber-dim);
    background: var(--amber-trace);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }

  .mech-step__algo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .algo-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-4);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .algo-value {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--amber);
  }

  .mechanism__policy-example {
    border: 1px solid var(--amber-border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-1);
  }

  .policy-example__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.5rem;
    background: var(--bg-2);
    border-bottom: 1px solid var(--border);
  }

  .policy-example__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-4);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .policy-example__badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--amber);
    background: var(--amber-trace);
    border: 1px solid var(--amber-border);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
  }

  .policy-example__code {
    padding: 1.75rem;
    overflow-x: auto;
    background: var(--bg);
  }

  .policy-example__code pre {
    margin: 0;
