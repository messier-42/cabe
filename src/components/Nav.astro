---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${base}/`,              label: 'Home' },
  { href: `${base}/specification`, label: 'Specification' },
  { href: `${base}/faq`,           label: 'FAQ' },
  { href: `${base}/get-involved`,  label: 'Get Involved' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="nav">
  <div class="container nav__inner">
    <a href={`${base}/`} class="nav__logo">
      <span class="nav__logo-mark">CABE</span>
      <span class="nav__logo-sub">Concise Attribute Based Encapsulation</span>
    </a>
    <ul class="nav__links">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav__link', { 'nav__link--active': currentPath === link.href.replace(/\/$/, '') }]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href={`${base}#mc-email`} class="nav__cta">Find out more</a>
      </li>
    </ul>
  </div>
</nav>
