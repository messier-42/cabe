---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-brand">
      <a class="brand" href={`${base}/`} aria-label="CABE home"><img src={`${base}/cabe-mark.svg`} alt="CABE" width="555" height="146" /></a>
      <span>Concise Attribute-Bound Encapsulation</span>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href={`${base}/faq/`}>FAQ</a>
      <a href={`${base}/get-involved/`}>Get involved</a>
      <a href="https://github.com/messier-42/cabe/issues" target="_blank" rel="noopener noreferrer">Discuss the specification</a>
      <a href="https://messier42.com/" target="_blank" rel="noopener noreferrer">Messier 42</a>
    </nav>
  </div>
</footer>
