---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';

export async function getStaticPaths() {
  const entries = await getCollection('spec');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${entry.data.title} — CABE`} description={entry.data.abstract}>
  <Nav />

  <main class="page">
    <div class="page__header">
      <div class="container">
        <span class="section-label">
          <a href={`${base}/specification`} style="color: inherit; text-decoration: none;">Specification</a>
          &nbsp;/&nbsp;{entry.data.draft}
        </span>
        <h1 class="page__title">{entry.data.title}</h1>
        <p class="page__subtitle">{entry.data.abstract}</p>
        <div class="spec-doc-meta">
          <span class="spec-doc-meta__item">{entry.data.status}</span>
          <span class="spec-doc-meta__sep">·</span>
          <span class="spec-doc-meta__item">{entry.data.date}</span>
        </div>
      </div>
    </div>

    <div class="page__body">
      <div class="container">
        <div class="spec-prose">
          <Content />
        </div>
      </div>
    </div>
  </main>

</Layout>

<style is:global>
  .spec-doc-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-4);
  }
  .spec-doc-meta__sep { color: var(--border); }

  .spec-prose { max-width: 100%; }

  /* ── Headings ────────────────────────────────────────────────── */
  .spec-prose h1, .spec-prose h2, .spec-prose h3, .spec-prose h4 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }
  .spec-prose h2 {
    font-size: 1.25rem;
    margin: 3.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-dim);
    color: var(--ink);
  }
  .spec-prose h3 {
    font-size: 1rem;
    font-weight: 700;
    margin: 2.25rem 0 0.6rem;
    color: var(--ink);
    font-family: var(--font-display);
  }
  .spec-prose h3::before {
    content: '§';
    color: var(--amber);
    margin-right: 0.45em;
    font-weight: 400;
    font-size: 0.9em;
    opacity: 0.7;
  }
  .spec-prose h4 {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink-2);
    margin: 1.75rem 0 0.5rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ── Body text ───────────────────────────────────────────────── */
  .spec-prose p {
    color: var(--ink-3);
    line-height: 1.85;
    font-weight: 300;
    font-size: 0.975rem;
    margin-bottom: 1.1rem;
  }
  .spec-prose em  { color: var(--ink); font-style: italic; }
  .spec-prose strong { color: var(--ink); font-weight: 600; }

  /* ── Inline code ─────────────────────────────────────────────── */
  .spec-prose code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--amber-dim);
    background: var(--amber-trace);
    padding: 0.12em 0.4em;
    border-radius: 3px;
    white-space: nowrap;
  }

  /* ── Code blocks ─────────────────────────────────────────────── */
  .spec-prose pre {
    border-left: 3px solid var(--amber-border);
    border-radius: 0 6px 6px 0;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0 1.75rem;
    font-size: 0.82rem;
  }
  /* Reset inline-code styling inside blocks; color/bg come from Astro's inline styles */
  .spec-prose pre code {
    background: transparent !important;
    color: inherit !important;
    padding: 0 !important;
    font-size: inherit !important;
    white-space: pre;
    border-radius: 0;
  }

  /* ── Lists ───────────────────────────────────────────────────── */
  .spec-prose ul, .spec-prose ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: var(--ink-3);
    font-weight: 300;
    font-size: 0.975rem;
  }
  .spec-prose li { margin-bottom: 0.45rem; line-height: 1.75; }
  .spec-prose li strong { color: var(--ink); font-weight: 600; }

  /* ── Blockquote ──────────────────────────────────────────────── */
  .spec-prose blockquote {
    border-left: 3px solid var(--amber-border);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--amber-trace);
    border-radius: 0 4px 4px 0;
  }
  .spec-prose blockquote p { margin: 0; color: var(--ink-2); }

  /* ── Links ───────────────────────────────────────────────────── */
  .spec-prose a { color: var(--amber); text-decoration: underline; text-decoration-color: var(--amber-border); }
  .spec-prose a:hover { color: var(--amber-bright); }

  /* ── Section dividers ────────────────────────────────────────── */
  .spec-prose hr { border: none; border-top: 1px solid var(--border-dim); margin: 3.5rem 0 0; }
  .spec-prose hr + h2 { margin-top: 2rem; }

  /* ── Table ───────────────────────────────────────────────────── */
  .spec-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin: 1.75rem 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }
  .spec-prose thead { background: var(--bg-2); }
  .spec-prose th {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--ink-4);
    border-bottom: 1px solid var(--border);
    padding: 0.6rem 1rem;
    text-align: left;
  }
  .spec-prose td {
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--border-dim);
    color: var(--ink-3);
    font-weight: 300;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .spec-prose td:first-child { color: var(--amber-dim); }
  .spec-prose tr:last-child td { border-bottom: none; }
  .spec-prose tbody tr:nth-child(even) { background: var(--bg); }
</style>
