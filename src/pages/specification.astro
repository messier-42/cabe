---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { specGroups } from '../data/specs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Specification — CABE" description="CABE specifications: core wire format, key access protocol, and policy expression language.">
  <Nav />

  <main class="page">
    <div class="page__header">
      <div class="container">
        <span class="section-label">Specification</span>
        <h1 class="page__title">Open for implementation.</h1>
        <p class="page__subtitle">
          CABE is specified across a set of publicly-available documents. The core
          specifications define the essential protocol; additional specifications
          extend it for specific use cases.
        </p>
      </div>
    </div>

    <div class="page__body">
      <div class="container">
        <div class="spec-index">
          {specGroups.map(group => (
            <div class="spec-group">
              <div class="spec-group__label">{group.label}</div>
              <div class="spec-group__docs">
                {group.specs.map(spec => (
                  spec.slug
                    ? <a href={`${base}/spec/${spec.slug}`} class="spec-entry">
                        <div class="spec-entry__draft">{spec.draft}</div>
                        <div class="spec-entry__title">{spec.title}</div>
                        <div class="spec-entry__desc">{spec.desc}</div>
                        <div class="spec-entry__footer">
                          <span class:list={['spec-entry__status', `spec-entry__status--${spec.statusType}`]}>
                            {spec.status}
                          </span>
                          <span class="spec-entry__arrow">→</span>
                        </div>
                      </a>
                    : <div class="spec-entry spec-entry--wip">
                        <div class="spec-entry__draft">{spec.draft}</div>
                        <div class="spec-entry__title">{spec.title}</div>
                        <div class="spec-entry__desc">{spec.desc}</div>
                        <div class="spec-entry__footer">
                          <span class:list={['spec-entry__status', `spec-entry__status--${spec.statusType}`]}>
                            {spec.status}
                          </span>
                        </div>
                      </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>

</Layout>

<style>
  .spec-entry {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-1);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  a.spec-entry:hover {
    border-color: var(--amber-border);
    box-shadow: 0 4px 20px rgba(184, 108, 0, 0.08);
  }

  .spec-entry--wip {
    opacity: 0.55;
  }

  .spec-entry__draft {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--amber-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .spec-entry__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.2;
  }

  .spec-entry__desc {
    font-size: 0.875rem;
    color: var(--ink-3);
    line-height: 1.7;
    font-weight: 300;
    flex: 1;
  }

  .spec-entry__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-dim);
  }

  .spec-entry__status {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
  }

  .spec-entry__status--active {
    color: var(--success);
    background: #e8f5ef;
    border: 1px solid #b0dfc8;
  }

  .spec-entry__status--pending {
    color: var(--ink-4);
    background: var(--bg-3);
    border: 1px solid var(--border);
  }

  .spec-entry__arrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--amber);
  }
</style>
