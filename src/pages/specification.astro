---
import Layout from '../layouts/Layout.astro';
import { specGroups } from '../data/specs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Specification — CABE" description="CABE specifications: core wire format, key access protocol, and policy expression language.">

  <main class="page" id="main" tabindex="-1">
    <div class="page__header">
      <div class="container">
        <span class="section-label">Specification</span>
        <h1 class="page__title">Open for implementation.</h1>
        <p class="page__subtitle">
          CABE is specified across a set of publicly-available documents. The core
          specifications define the essential protocol; additional specifications
          extend it for specific use cases.
        </p>
      </div>
    </div>

    <div class="page__body">
      <div class="container">
        <div class="spec-index">
          {specGroups.map(group => (
            <div class="spec-group">
              <h2 class="spec-group__label">{group.label}</h2>
              <div class="spec-group__docs">
                {group.specs.map(spec => (
                  spec.slug
                    ? <a href={`${base}/spec/${spec.slug}/`} class="spec-entry">
                        <div class="spec-entry__draft">{spec.draft}</div>
                        <h3 class="spec-entry__title">{spec.title}</h3>
                        <div class="spec-entry__desc">{spec.desc}</div>
                        <div class="spec-entry__footer">
                          <span class:list={['spec-entry__status', `spec-entry__status--${spec.statusType}`]}>
                            {spec.status}
                          </span>
                          <span class="spec-entry__arrow">→</span>
                        </div>
                      </a>
                    : <div class="spec-entry spec-entry--wip">
                        <div class="spec-entry__draft">{spec.draft}</div>
                        <h3 class="spec-entry__title">{spec.title}</h3>
                        <div class="spec-entry__desc">{spec.desc}</div>
                        <div class="spec-entry__footer">
                          <span class:list={['spec-entry__status', `spec-entry__status--${spec.statusType}`]}>
                            {spec.status}
                          </span>
                        </div>
                      </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>

</Layout>

<style>
  .spec-index { display: grid; gap: 44px; }
  .spec-group__label { font-size: 18px; font-weight: 600; margin: 0 0 20px; }
  .spec-group__docs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .spec-entry { display: flex; flex-direction: column; gap: 13px; padding: 24px; border: 1px solid var(--line); border-radius: 8px; color: inherit; text-decoration: none; }
  a.spec-entry:hover { border-color: var(--blue-line); background: var(--blue-soft); }
  .spec-entry__draft { font: 12px/1.6 var(--font-mono); color: var(--blue); }
  .spec-entry__title { font-size: 19px; line-height: 1.4; }
  .spec-entry__desc { font-size: 14px; color: var(--muted); flex: 1; }
  .spec-entry__footer { display: flex; justify-content: space-between; align-items: center; gap: 15px; padding-top: 16px; margin-top: 4px; border-top: 1px solid var(--line); }
  .spec-entry__status { font-size: 12px; color: var(--muted); }
  .spec-entry__status--active { color: var(--pass); }
  .spec-entry__arrow { color: var(--blue); }
  @media (max-width: 900px) { .spec-group__docs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .spec-group__docs { grid-template-columns: 1fr; } .spec-entry { padding: 22px; } }
  @media print { .spec-group__docs { grid-template-columns: repeat(2, minmax(0, 1fr)); } .spec-entry { break-inside: avoid; } }
</style>
