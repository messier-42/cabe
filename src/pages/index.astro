---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { specGroups } from '../data/specs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const coreGroup = specGroups[0];
const additionalGroup = specGroups[1];
---

<Layout>
  <Nav />

  <!-- HERO -->
  <section class="hero" id="top">
    <div class="hero__grid-bg" aria-hidden="true"></div>
    <div class="hero__circuit" aria-hidden="true">
      <svg viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
        <g stroke="#b86c00" stroke-width="0.5" fill="none" opacity="0.2">
          <path d="M0,150 H200 V50 H400 V150 H600 V250 H800" />
          <path d="M0,350 H100 V450 H300 V350 H500 V550 H700 V450 H800" />
          <path d="M200,50 V0" /><path d="M400,150 V0" /><path d="M600,250 V150" />
          <path d="M100,450 V600" /><path d="M300,350 V600" /><path d="M700,450 V600" />
          <circle cx="200" cy="50" r="4" fill="#b86c00" opacity="0.5" />
          <circle cx="400" cy="150" r="4" fill="#b86c00" opacity="0.5" />
          <circle cx="600" cy="250" r="4" fill="#b86c00" opacity="0.5" />
          <circle cx="100" cy="450" r="4" fill="#b86c00" opacity="0.5" />
          <circle cx="300" cy="350" r="4" fill="#b86c00" opacity="0.5" />
          <circle cx="700" cy="450" r="4" fill="#b86c00" opacity="0.5" />
          <rect x="190" y="40" width="20" height="20" rx="2" stroke="#b86c00" opacity="0.35"/>
          <rect x="390" y="140" width="20" height="20" rx="2" stroke="#b86c00" opacity="0.35"/>
          <rect x="590" y="240" width="20" height="20" rx="2" stroke="#b86c00" opacity="0.35"/>
        </g>
      </svg>
    </div>

    <div class="container hero__content">
      <div class="hero__badge">
        <span class="hero__badge-dot"></span>
        <span class="hero__badge-text">Draft Specification</span>
      </div>

      <h1 class="hero__title">
        <span class="hero__title-line hero__title-line--3">CABE:</span>
        <span class="hero__title-line hero__title-line--2">Concise Attribute-Bound Encapsulation</span>
      </h1>

      <div class="hero__sub-row">
        <div class="hero__mono-tag">CABE</div>
        <p class="hero__subtitle">
          Low-overhead data encryption bound by attribute-based policy.
          Isolate and compartmentalise information flow based on arbitrary metadata.
        </p>
      </div>

      <div class="hero__actions">
        <a href="#spec" class="btn btn--primary">Read Specification</a>
        <a href="#overview" class="btn btn--ghost">Learn the Standard →</a>
      </div>
    </div>
  </section>

  <!-- OVERVIEW -->
  <section class="overview" id="overview">
    <div class="container overview__inner">
      <div class="overview__label">
        <span class="section-label">001 · Overview</span>
      </div>
      <div class="overview__body">
        <h2 class="overview__heading">
          Encryption that understands<br /><em style="font-style:normal;">context.</em>
        </h2>
        <div class="overview__columns">
          <div class="overview__col">
            <p>
              With CABE, data of any size can be safely encrypted for transport through
              untrusted and hostile environments, while being labeled according to the
              identity and context of the producer. CABE can support any labelling schema
              as needed to support mission objectives — label data according to
              sensitivity, compartment, or based on any other selector.
            </p>
          </div>
          <div class="overview__col">
            <p>
              Every object is bound to its associated label metadata and encrypted before
              transport or storage. Decryption is gated by attribute-based access control
              (ABAC) policy which can be configured as needed for the mission environment.
              Both protected data objects and workloads accessing objects are assigned a
              set of metadata labels, and system policy determines which workloads can
              access which data according to arbitrary metadata predicates.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SCALABLE -->
  <section class="scalable" id="scalable">
    <div class="container scalable__inner">
      <div class="scalable__label">
        <span class="section-label">002 · Performance</span>
      </div>
      <div class="scalable__body">
        <h2 class="scalable__heading">Scalable to any object size.</h2>
        <p class="scalable__text">
          CABE is built on cryptographic primitives which are post-quantum safe, and
          state-of-the-art internet ecosystem standards such as the IETF's COSE and
          CBOR, providing a compact, low-overhead envelope format. CABE can scale
          performantly to messages which are arbitrarily large — or arbitrarily small,
          even a single byte.
        </p>
        <div class="scalable__tags">
          <span class="scalable__tag">Post-quantum safe primitives</span>
          <span class="scalable__tag">IETF COSE &amp; CBOR</span>
          <span class="scalable__tag">Compact envelope format</span>
          <span class="scalable__tag">Arbitrary message size</span>
        </div>
      </div>
    </div>
  </section>

  <!-- GAME INVITATION -->
  <section class="game-invite" id="game">
    <div class="game-invite__grid" aria-hidden="true"></div>
    <div class="game-invite__scan" aria-hidden="true"></div>
    <div class="game-invite__corners" aria-hidden="true">
      <span class="gi-corner gi-corner--tl"></span>
      <span class="gi-corner gi-corner--tr"></span>
      <span class="gi-corner gi-corner--bl"></span>
      <span class="gi-corner gi-corner--br"></span>
    </div>
    <div class="container game-invite__inner">
      <div class="game-invite__meta">
        <span class="gi-tag"><span class="gi-tag__dot"></span>INTERACTIVE SIMULATOR</span>
        <span class="gi-id">CABE</span>
      </div>

      <h2 class="game-invite__title">
        Try the simulation.
      </h2>

      <p class="game-invite__lede">
        Get your hands on with CABE concepts with the <strong>CABE Policy
        Simulator</strong> — an interactive browser-based introduction to
        attribute-based encapsulation based around a live demonstration of
        a real Cedar policy evaluation engine driving key management.
      </p>

      <ul class="game-invite__points">
        <li><span class="gi-bullet">▸</span> Explore an example mission scenario</li>
        <li><span class="gi-bullet">▸</span> Test policies in the real Cedar policy engine</li>
        <li><span class="gi-bullet">▸</span> See how CABE message envelopes are constructed</li>
      </ul>

      <div class="game-invite__action">
        <a href="/game/" class="gi-btn">
          <span class="gi-btn__bracket">[</span>
          <span class="gi-btn__label">LAUNCH&nbsp;CABE&nbsp;Policy&nbsp;Simulator</span>
          <span class="gi-btn__bracket">]</span>
          <span class="gi-btn__arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SPEC -->
  <section class="spec" id="spec">
    <div class="container">
      <div class="section-header">
        <span class="section-label">003 · Specification</span>
        <h2 class="section-heading">An open specification.</h2>
        <p class="section-subheading">
          CABE is a family of publicly-available specifications that fit together in a
          cohesive framework.
        </p>
      </div>

      {specGroups.map((group, i) => (
        <div class:list={['spec__group', { 'spec__group--secondary': i > 0 }]}>
          <h3 class="spec__group-title">{group.label}</h3>
          <p class="spec__group-desc">{group.desc}</p>
          <div class="spec__list">
            {group.specs.map(spec => (
              <div class:list={['spec-item', { 'spec-item--wip': !spec.slug }]}>
                <div class="spec-item__header">
                  <h4 class="spec-item__title">{spec.title}</h4>
                  <span class:list={['spec-item__status', `spec-item__status--${spec.statusType}`]}>
                    {spec.status}
                  </span>
                </div>
                <p class="spec-item__desc">{spec.desc}</p>
                {spec.slug && (
                  <a href={`${base}/spec/${spec.slug}`} class="spec-item__link">Read specification →</a>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}

      <div class="spec__cta">
        <a href={`${base}/specification`} class="btn btn--primary">View all specifications</a>
      </div>
    </div>
  </section>

  <!-- SOFTWARE TEASER -->
  <section class="sw-teaser" id="software">
    <div class="sw-teaser__grid-bg" aria-hidden="true"></div>
    <div class="sw-teaser__glow" aria-hidden="true"></div>
    <div class="container sw-teaser__inner">
      <div class="sw-teaser__copy">
        <span class="section-label sw-teaser__label">004 · Software</span>
        <h2 class="sw-teaser__heading">Deploy CABE-compatible software.</h2>
        <p class="sw-teaser__body">
          The CABE specifications are open for implementation. <strong>khaled</strong>
          is our reference implementation of a CABE Key Server; a highly pluggable,
          configurable key server designed to support a wide variety of operating
          scenarios based around attribute-based policy enforcement.
        </p>
        <ul class="sw-teaser__points">
          <li>Plugin-based architecture</li>
          <li>SPIFFE and Kubernetes-aware workload attestation</li>
          <li>Cedar-based ABAC policy evaluation</li>
        </ul>
        <div class="sw-teaser__actions">
          <a href={`${base}/software`} class="btn sw-teaser__btn">View Implementations</a>
          <a href="https://khaled.cabespec.org/" class="sw-teaser__inline-link">Visit khaled docs →</a>
        </div>
      </div>

      <a href="https://khaled.cabespec.org/" class="sw-teaser__card" aria-label="khaled — CABE Key Server">
        <div class="sw-teaser__card-corner sw-teaser__card-corner--tl"></div>
        <div class="sw-teaser__card-corner sw-teaser__card-corner--tr"></div>
        <div class="sw-teaser__card-corner sw-teaser__card-corner--bl"></div>
        <div class="sw-teaser__card-corner sw-teaser__card-corner--br"></div>

        <div class="sw-teaser__card-tag">
          <span class="sw-teaser__card-dot"></span>
          Reference Implementation
        </div>

        <img
          src={`${base}/images/khaled-logo.svg`}
          alt="khaled"
          class="sw-teaser__card-logo"
          width="532"
          height="173"
        />

        <p class="sw-teaser__card-tagline">
          A plugin-based CABE Key Server.
        </p>

        <span class="sw-teaser__card-cta">
          Learn more <span class="sw-teaser__card-arrow">→</span>
        </span>
      </a>
    </div>
  </section>

  <!-- CTA / MAILING LIST -->
  <section class="mc-section" id="cta">
    <div class="mc-glow" aria-hidden="true"></div>
    <div class="container mc-inner">
      <div class="mc-text">
        <span class="section-label mc-label">Find out more</span>
        <h2 class="mc-heading">Join the CABE ecosystem.</h2>
        <p class="mc-body">
          Sign up and receive more information on:
        </p>
        <ul class="mc-list">
          <li><strong>Adoptees.</strong> Adopting CABE in your organization</li>
          <li><strong>Incorporators.</strong> Incorporating CABE technology into your products</li>
          <li><strong>Collaborators.</strong> Getting involved in the specification process</li>
        </ul>
      </div>

      <div class="mc-form-wrap">
        <!-- Mailchimp embedded form -->
        <form
          action="https://messier42.us19.list-manage.com/subscribe/post?u=f91016b8b104eeb6c1e840cc8&amp;id=edafba7923&amp;f_id=0094c2e1f0"
          method="post"
          target="_blank"
          novalidate
          class="mc-form"
        >
          <!-- Real field -->
          <div class="mc-field">
            <label for="mc-email" class="mc-field__label">Email address</label>
            <div class="mc-field__row">
              <input
                type="email"
                name="EMAIL"
                id="mc-email"
                placeholder="you@example.com"
                required
                class="mc-field__input"
              />
              <button type="submit" name="subscribe" class="mc-field__btn btn btn--primary">
                Subscribe
              </button>
            </div>
          </div>
          <!-- Mailchimp bot-trap — do not remove -->
          <div style="position:absolute;left:-5000px" aria-hidden="true">
            <input type="text" name="b_f91016b8b104eeb6c1e840cc8_edafba7923" tabindex="-1" value="" />
          </div>
          <input type="hidden" name="tags" value="410" />
          <p class="mc-note">
            By subscribing you agree to receive CABE-related updates.
            Unsubscribe at any time.
          </p>
        </form>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ─── SCALABLE SECTION ─────────────────────────────────────── */
  .scalable {
    padding: var(--section-pad) 0;
    background: var(--bg-2);
    border-top: 1px solid var(--border-dim);
    border-bottom: 1px solid var(--border-dim);
  }

  .scalable__inner {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 4rem;
    align-items: start;
  }

  .scalable__heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--ink);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .scalable__text {
    font-size: 1rem;
    color: var(--ink-3);
    line-height: 1.8;
    font-weight: 300;
    max-width: 62ch;
    margin-bottom: 2rem;
  }

  .scalable__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .scalable__tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--amber);
    background: var(--amber-trace);
    border: 1px solid var(--amber-border);
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
  }

  /* ─── SPEC SECTION ─────────────────────────────────────────── */
  .section-subheading {
    font-size: 1rem;
    color: var(--ink-3);
    font-weight: 300;
    line-height: 1.7;
    max-width: 56ch;
    margin-top: 0.75rem;
  }

  .spec__group {
    margin-top: 3.5rem;
  }

  .spec__group--secondary {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-dim);
  }

  .spec__group-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-4);
    margin-bottom: 0.4rem;
  }

  .spec__group-desc {
    font-size: 0.9rem;
    color: var(--ink-3);
    font-weight: 300;
    margin-bottom: 1.75rem;
  }

  .spec__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .spec-item {
    padding: 1.75rem 2rem;
    background: var(--bg-1);
    border-bottom: 1px solid var(--border-dim);
  }

  .spec-item:last-child {
    border-bottom: none;
  }

  .spec-item--wip {
    background: var(--bg);
    opacity: 0.75;
  }

  .spec-item__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
    flex-wrap: wrap;
  }

  .spec-item__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
  }

  .spec-item__status {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    flex-shrink: 0;
  }

  .spec-item__status--active {
    color: var(--success);
    background: #e8f5ef;
    border: 1px solid #b0dfc8;
  }

  .spec-item__status--pending {
    color: var(--ink-4);
    background: var(--bg-3);
    border: 1px solid var(--border);
  }

  .spec-item__desc {
    font-size: 0.9rem;
    color: var(--ink-3);
    line-height: 1.7;
    font-weight: 300;
    margin-bottom: 1rem;
    max-width: 68ch;
  }

  .spec-item__link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--amber);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .spec-item__link:hover { color: var(--amber-bright); }

  .spec__cta {
    margin-top: 2.5rem;
  }

  /* ─── MAILING LIST LIST ─────────────────────────────────────── */
  .mc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }

  .mc-list li {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.7);
    font-weight: 300;
    line-height: 1.6;
    padding-left: 1rem;
    position: relative;
  }

  .mc-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--amber);
    font-weight: 400;
  }

  .mc-list li strong {
    color: rgba(255,255,255,0.9);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .scalable__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  /* ─── GAME INVITATION ──────────────────────────────────────── */
  .game-invite {
    --gi-cyan: #00c8ff;
    --gi-cyan-soft: #7ee3ff;
    --gi-cyan-glow: rgba(0, 200, 255, 0.18);
    --gi-bg: #030d12;
    --gi-bg-deep: #020608;
    --gi-amber: #ffb300;
    --gi-text: #d8e5ef;
    --gi-text-mute: #8aa2b3;

    position: relative;
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(0,200,255,0.08) 0%, transparent 60%),
      radial-gradient(ellipse 60% 50% at 80% 100%, rgba(255,179,0,0.06) 0%, transparent 60%),
      linear-gradient(180deg, var(--gi-bg-deep) 0%, var(--gi-bg) 100%);
    color: var(--gi-text);
    border-top: 1px solid rgba(0, 200, 255, 0.18);
    border-bottom: 1px solid rgba(0, 200, 255, 0.18);
    overflow: hidden;
    font-family: 'JetBrains Mono', ui-monospace, 'Menlo', monospace;
  }

  .game-invite__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 200, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 200, 255, 0.06) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: radial-gradient(ellipse 90% 100% at 50% 50%, black 35%, transparent 100%);
    pointer-events: none;
  }

  .game-invite__scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 3px,
      rgba(0, 200, 255, 0.025) 3px,
      rgba(0, 200, 255, 0.025) 4px
    );
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .game-invite__corners {
    position: absolute;
    inset: 1.5rem;
    pointer-events: none;
  }

  .gi-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--gi-cyan);
    border-style: solid;
    border-width: 0;
    opacity: 0.7;
  }
  .gi-corner--tl { top: 0; left: 0; border-top-width: 1px; border-left-width: 1px; }
  .gi-corner--tr { top: 0; right: 0; border-top-width: 1px; border-right-width: 1px; }
  .gi-corner--bl { bottom: 0; left: 0; border-bottom-width: 1px; border-left-width: 1px; }
  .gi-corner--br { bottom: 0; right: 0; border-bottom-width: 1px; border-right-width: 1px; }

  .game-invite__inner {
    position: relative;
    z-index: 2;
    max-width: 820px;
  }

  .game-invite__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .gi-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgba(0, 200, 255, 0.4);
    background: rgba(0, 200, 255, 0.06);
    border-radius: 2px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--gi-cyan-soft);
    text-transform: uppercase;
  }

  .gi-tag__dot {
    width: 6px;
    height: 6px;
    background: var(--gi-cyan);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--gi-cyan);
    animation: gi-pulse 1.6s ease-in-out infinite;
  }

  .gi-id {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: var(--gi-text-mute);
    text-transform: uppercase;
  }

  .game-invite__title {
    font-family: 'Orbitron', sans-serif;
    font-weight: 900;
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    line-height: 1.0;
    letter-spacing: 0.02em;
    color: #ffffff;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    text-shadow: 0 0 24px var(--gi-cyan-glow);
  }

  .game-invite__lede {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.7;
    color: var(--gi-text);
    font-weight: 300;
    max-width: 60ch;
    margin-bottom: 1.75rem;
  }

  .game-invite__lede strong {
    font-family: 'Orbitron', sans-serif;
    color: var(--gi-cyan-soft);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .game-invite__points {
    list-style: none;
    margin: 0 0 2.5rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .game-invite__points li {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--gi-text);
  }

  .gi-bullet {
    color: var(--gi-cyan);
    margin-right: 0.6rem;
    font-weight: 700;
  }

  .game-invite__action {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .gi-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem 1.6rem;
    background: linear-gradient(180deg, rgba(0, 200, 255, 0.18) 0%, rgba(0, 200, 255, 0.08) 100%);
    border: 1px solid var(--gi-cyan);
    border-radius: 2px;
    color: #ffffff;
