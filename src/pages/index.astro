---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="CABE — Attribute-based access control for encrypted data"
  description="CABE is a concise encrypted message format and key access protocol for attribute-based access control over encrypted data."
>
<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" aria-hidden="true" style="position:absolute;overflow:hidden"><defs>
<symbol id="arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6"/></symbol>
<symbol id="external" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12"/></symbol>
<symbol id="chevron" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
<symbol id="menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
<symbol id="play" viewBox="0 0 24 24"><path d="m8 5 11 7-11 7z"/></symbol>
<symbol id="copy" viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V4H4v12h4"/></symbol>
</defs></svg>
<main class="home-page" id="main" tabindex="-1">
<div class="wrap">
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow">Concise Attribute-Bound Encapsulation</p>
      <h1 id="hero-title">Attribute-based access control<br> for encrypted data</h1>
      <p class="hero-copy">CABE defines an encrypted message format and a protocol for obtaining keys under an attribute based access policy. Applications can exchange protected data through brokers, relays and storage services which do not need access to the plaintext.</p>
      <div class="actions">
        <a class="button primary" href="#simulator">Try the policy simulator <svg class="icon" aria-hidden="true"><use href="#arrow"/></svg></a>
        <a class="button" href={`${base}/spec/arch/`}>Read the architecture <svg class="icon" aria-hidden="true"><use href="#external"/></svg></a>
      </div>
    </div>

  </section>

  <section class="section purpose split" id="why-cabe" aria-labelledby="purpose-title">
    <div><h2 id="purpose-title">Why CABE?</h2></div>
    <div class="prose">
      <p>Applications which need to cooperate do not necessarily share the same operators, permissions or assumptions about trust. Putting them on the same network does not resolve those differences.</p>
      <p>A report may pass through several systems before reaching the application which needs it. A partner may be entitled to selected observations but not the whole collection. The infrastructure carrying that information need not be entitled to read it.</p>
      <p>We want to make these exchanges possible without requiring each application to invent its own protection and key-distribution scheme. This includes frequent telemetry, live information and work passed between services, as well as files. CABE supplies a common envelope and policy controlled key access which those larger systems can build on.</p>
    </div>
  </section>

  <section class="section foundation" id="how-it-works" aria-labelledby="how-title">
    <div class="section-intro">
      <h2 id="how-title">A shared broker <br>with two consumers</h2>
      <p>Suppose a sensor publishes observations through a broker used by an analysis application and a maintenance application. Both can receive the messages. Whether either can read them is a separate question, answered by the key service’s policy.</p>
    </div>

    <figure class="figure">
      <div class="figure-top"><span>One CABE domain</span><div class="legend" aria-hidden="true"><span><i></i>Encrypted message</span><span><i class="key"></i>Key service interaction</span></div></div>
      <svg class="architecture" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1120 356" role="img" aria-labelledby="architecture-title architecture-desc">
        <title id="architecture-title">Message delivery and policy controlled key access</title>
        <desc id="architecture-desc">The producer assigns attributes and requests a lease from the key service. The broker delivers the encrypted observation to both consumers. In this illustrative khaled configuration, authentication and claims mapping supply facts to Cedar. The policy permits the analysis consumer and refuses the maintenance consumer. Neither consumer already has the decryption key.</desc>
        <defs>
          <marker id="data-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto-start-reverse"><path d="M1 1l6 3-6 3" fill="none" stroke="#737b85" stroke-width="1.2"/></marker>
          <marker id="key-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto-start-reverse"><path d="M1 1l6 3-6 3" fill="none" stroke="#356da2" stroke-width="1.2"/></marker>
        </defs>
        <path d="M144 217V77H370" fill="none" stroke="#356da2" stroke-width="1.4" stroke-dasharray="5 5" marker-start="url(#key-arrow)" marker-end="url(#key-arrow)"/>
        <path d="M750 57H934V190" fill="none" stroke="#356da2" stroke-width="1.4" stroke-dasharray="5 5" marker-start="url(#key-arrow)" marker-end="url(#key-arrow)"/>
        <path d="M750 86H1087V305H1059" fill="none" stroke="#356da2" stroke-width="1.4" stroke-dasharray="5 5" marker-start="url(#key-arrow)" marker-end="url(#key-arrow)"/>
        <text x="165" y="141" class="node-small">Authenticate and</text><text x="165" y="162" class="node-small">request a lease</text>
        <text x="778" y="131" class="node-small">Authenticate</text><text x="778" y="152" class="node-small">Request key access</text>
        <rect x="370" y="27" width="380" height="111" rx="7" fill="#f3f7fb" stroke="#b5c9dc"/>
        <text x="392" y="55" class="node-title">Key service <tspan class="node-sub">/ khaled</tspan></text>
        <text x="392" y="81" class="node-small">Authenticated claims + attributes + operation</text>
        <rect x="391" y="96" width="112" height="25" rx="4" fill="white" stroke="#cad7e2"/>
        <text x="407" y="113" class="node-small" style="fill:#265f99;font-weight:600">Cedar policy</text>
        <path d="M514 108H545" stroke="#356da2" stroke-width="1.3" marker-end="url(#key-arrow)"/>
        <text x="557" y="113" class="node-small">Key access decision</text>
        <rect x="28" y="218" width="232" height="102" rx="7" fill="white" stroke="#d3d8de"/>
        <text x="49" y="249" class="node-title">Producer</text><text x="49" y="273" class="node-sub">Assigns attributes</text><text x="49" y="295" class="node-sub">Encrypts the observation</text>
        <path d="M260 269H393" stroke="#737b85" stroke-width="1.5" marker-end="url(#data-arrow)"/>
        <text x="276" y="251" class="node-small">CABE envelope</text>
        <rect x="395" y="218" width="252" height="102" rx="7" fill="#f8f9fb" stroke="#d3d8de"/>
        <text x="417" y="249" class="node-title">Shared broker</text><text x="417" y="273" class="node-sub">Delivers the same ciphertext</text><text x="417" y="295" class="node-sub">Has no decryption key</text>
        <path d="M647 269H716M716 224V304" stroke="#737b85" fill="none" stroke-width="1.5"/>
        <path d="M716 224H807" stroke="#737b85" fill="none" stroke-width="1.5" marker-end="url(#data-arrow)"/><path d="M716 304H807" stroke="#737b85" fill="none" stroke-width="1.5" marker-end="url(#data-arrow)"/>
        <rect x="810" y="190" width="249" height="67" rx="7" fill="white" stroke="#d3d8de"/><text x="831" y="216" class="node-title">Analysis consumer</text><text x="831" y="240" class="node-small" style="fill:#176543">Key access permitted</text>
        <rect x="810" y="272" width="249" height="67" rx="7" fill="white" stroke="#d3d8de"/><text x="831" y="298" class="node-title">Maintenance consumer</text><text x="831" y="322" class="node-small" style="fill:#a33636">Key access refused</text>
      </svg>
      <div class="mobile-architecture">
        <div class="mobile-key"><strong>Key service / khaled</strong>Authentication and claims mapping → Cedar policy evaluation → key access decision.</div>
        <ol class="mobile-flow">
          <li><strong>Producer</strong><p>Assigns attributes, obtains a lease and encrypts the observation.</p></li>
          <li><strong>Shared broker</strong><p>Delivers the same ciphertext to both consumers. It has no decryption key.</p></li>
          <li><strong>Consumers request key access</strong><p class="allowed">Analysis application — key access permitted</p><p class="denied">Maintenance application — key access refused</p></li>
        </ol>
      </div>
      <figcaption class="caption">Illustrative non-captive key flow. The producer is authorised to publish; neither consumer already holds the key. The rule and its inputs are shown below.</figcaption>
    </figure>

    <div class="policy-worked" aria-labelledby="policy-title">
      <div class="policy-heading"><div><p class="section-kicker">The decision inside the key service</p><h3 id="policy-title">How access is decided</h3></div><span class="quiet-tag">Illustrative configuration</span></div>
      <div class="policy-inputs">
        <div class="object-input">
          <h4>Message attributes</h4>
          <pre><code is:raw>{
  "project": "survey",
  "product": "observation",
  "release-to": ["ExampleOrg"]
}</code></pre>
          <p>The producer assigns these to the message.</p>
        </div>
        <div class="claims-input">
          <h4>Established caller claims</h4>
          <div class="claims-grid">
            <div><strong>Analysis application</strong><dl><div><dt>Project</dt><dd>survey</dd></div><div><dt>Organisation</dt><dd>ExampleOrg</dd></div><div><dt>Function</dt><dd>analysis</dd></div></dl></div>
            <div><strong>Maintenance application</strong><dl><div><dt>Project</dt><dd>survey</dd></div><div><dt>Organisation</dt><dd>ExampleOrg</dd></div><div><dt>Function</dt><dd>maintenance</dd></div></dl></div>
          </div>
          <p>Authentication and claims mapping supply these facts. The application’s name grants no permission by itself.</p>
        </div>
      </div>
      <div class="policy-rule">
        <div><h4>Configured access rule</h4><p>For decryption requests, require the same project, a permitted organisation and an approved function for the product.</p></div>
        <dl class="function-map"><div><dt>analysis</dt><dd>observation</dd></div><div><dt>maintenance</dt><dd>equipment-status</dd></div></dl>
      </div>
      <div class="decision-table-wrap">
        <table class="decision-table">
          <caption>Applying the rule to the observation above</caption>
          <thead><tr><th scope="col">Policy check</th><th scope="col">Analysis application</th><th scope="col">Maintenance application</th></tr></thead>
          <tbody>
            <tr><th scope="row">Project matches</th><td><span class="check yes">✓</span> survey</td><td><span class="check yes">✓</span> survey</td></tr>
            <tr><th scope="row">Organisation is permitted</th><td><span class="check yes">✓</span> ExampleOrg</td><td><span class="check yes">✓</span> ExampleOrg</td></tr>
            <tr><th scope="row">Function permits this product</th><td><span class="check yes">✓</span> Observations permitted</td><td><span class="check no">×</span> Equipment status only</td></tr>
          </tbody>
          <tfoot><tr><th scope="row">Key request</th><td><span class="decision-badge allow">ALLOW</span></td><td><span class="decision-badge deny">DENY</span></td></tr></tfoot>
        </table>
      </div>
      <p class="policy-foot">The broker delivered the same envelope to both applications. The key service evaluated their requests separately.</p>
    </div>

    <div class="cedar-explanation">
      <div><h3>Where Cedar fits</h3><a class="more-link" href="https://khaled.cabespec.org/overview/arch/" target="_blank" rel="noopener noreferrer">Policy integration <svg class="icon" aria-hidden="true"><use href="#external"/></svg></a></div>
      <div><p>CABE does not prescribe a policy language. The reference key server <strong>khaled</strong> supports pluggable policy languages; the Cedar policy language is supported out of the box. The server uses the policy decision to control key access; authentication and claims mapping establish the facts on which it depends.</p></div>
    </div>
  </section>
</div>

<section class="simulator-section" id="simulator" aria-labelledby="simulator-title">
  <div class="wrap">
    <div class="simulator-intro"><div><h2 id="simulator-title">Try the policy simulator</h2><p>Work through the full CABE example, change access rules and inspect the message envelope. The hosted simulator uses Cedar for policy evaluation.</p></div><a class="button" href={`${base}/game/`} target="_blank" rel="noopener noreferrer">Open simulator <svg class="icon" aria-hidden="true"><use href="#external"/></svg></a></div>
    <div class="simulator-shell">
      <div class="simulator-bar"><span>CABE Policy Simulator</span><span>cabespec.org/game</span></div>
      <div class="simulator-launch" id="simulator-launch"><div><h3>Experiment with access policy</h3></div><button class="button primary" id="load-simulator" type="button" aria-controls="simulator-host" aria-expanded="false">Load simulator <svg class="icon" aria-hidden="true"><use href="#play"/></svg></button></div>
      <div class="simulator-host" id="simulator-host" data-src={`${base}/game/`} hidden><div class="embed-bar"><span>Use the direct link if your browser does not allow embedding.</span><button class="close-embed" id="close-simulator" type="button">Close simulator</button></div></div>
      <div class="simulator-footer"><span></span><a href={`${base}/game/`} target="_blank" rel="noopener noreferrer">Open in a new tab <svg class="icon" aria-hidden="true"><use href="#external"/></svg></a></div>
    </div>
  </div>
</section>

<div class="wrap">
  <section class="section architecture-notes" aria-labelledby="model-title">
    <div class="section-intro"><h2 id="model-title">Messages, leases <br>and domains</h2><p>This example demonstrates single domain operation. The same envelope and key access model can support arbitrarily frequent messages and exchanges between independently operated domains.</p></div>
    <div class="architecture-columns">
      <div><h3>Key material can be reused.</h3><p>A suitable non-captive lease lets a client encrypt further messages with the same attributes locally until the lease expires. This avoids a key service round trip for every event. Lease reuse and rollover also determine how quickly a policy change affects future messages.</p><a class="more-link" href={`${base}/spec/ckap/`}>Key access and leases <svg class="icon" aria-hidden="true"><use href="#arrow"/></svg></a></div>
      <div><h3>Concise at any message size.</h3><p>CABE is a concise encapsulation scheme which can scale to arbitrarily large or arbitrarily small messages.</p><a class="more-link" href={`${base}/spec/cbes/`}>Envelope structure <svg class="icon" aria-hidden="true"><use href="#arrow"/></svg></a></div>
      <div><h3>Domains can prepare to share.</h3><p>The federation draft defines lease packages which let a receiving key service recover material for a foreign envelope without a live request to its origin.</p><a class="more-link" href={`${base}/spec/cfar/`}>Federation and preparation <svg class="icon" aria-hidden="true"><use href="#arrow"/></svg></a></div>
    </div>
  </section>

  <section class="section" id="applications" aria-labelledby="applications-title">
    <div class="section-intro"><h2 id="applications-title">Applications</h2><p>These are different uses of the same foundation. Each has its own producer, permitted consumers and delivery path.</p></div>
    <div class="application-list">
      <article class="application-row"><div><span class="application-index">01</span><h3>Telemetry and <br>application events</h3></div><div><p>A shared event service may carry equipment readings, observations and application results for several consumers. Access rules can distinguish these products without making the broker a trusted reader of their payloads. Suitable leases allow local key use across multiple messages.</p></div></article>
      <article class="application-row"><div><span class="application-index">02</span><h3>Satellite and <br>coalition information</h3></div><div><p>An analysis application may need selected products from a satellite provider or coalition information service rather than access to its entire collection. The provider’s release rules determine which consumers may obtain which products. For a live feed, an application can protect finite video segments before they reach a shared relay or cache.</p></div></article>
      <article class="application-row"><div><span class="application-index">03</span><h3>A partner observation <br>reaching the field</h3></div><div><p>Suppose a partner has a current observation about a drone, and an authorised SOF application needs it for situational awareness. The desired exchange is from the partner’s publishing application to that receiver, without making each relay an entitled reader of the observation.</p></div></article>
      <article class="application-row"><div><span class="application-index">04</span><h3>An ally-operated <br>radio mesh</h3></div><div><p>An ally’s mobile ad hoc network may provide an available path between applications. Protected application data can use that path without giving the radios and relays its decryption keys. Access to the transport and access to the payload are different permissions.</p></div></article>
    </div>
  </section>

  <section class="section" id="software" aria-labelledby="software-title">
    <div class="section-intro"><h2 id="software-title">Software</h2></div>
    <div class="software-grid">
      <div class="software-list">
        <article class="software-item"><h3>khaled</h3><div><p>The reference key server, including Cedar policy evaluation and plugins for authentication, claims mapping and key storage.</p><a class="more-link" href="https://khaled.cabespec.org/reference/config/" target="_blank" rel="noopener noreferrer">Server configuration <svg class="icon" aria-hidden="true"><use href="#arrow"/></svg></a></div></article>
        <article class="software-item"><h3>cabe-go</h3><div><p>The Go client library. Its <code>cabecap</code> interface handles encapsulation, decapsulation and lease caching.</p><a class="more-link" href="https://github.com/messier-42/cabe-go#quick-start" target="_blank" rel="noopener noreferrer">Client example <svg class="icon" aria-hidden="true"><use href="#arrow"/></svg></a></div></article>
        <article class="software-item"><h3>cabetool</h3><div><p>Command-line tooling for client identity, encryption and decryption, included with <code>cabe-go</code>.</p><a class="more-link" href="https://github.com/messier-42/cabe-go#command-line-tool" target="_blank" rel="noopener noreferrer">Command-line usage <svg class="icon" aria-hidden="true"><use href="#arrow"/></svg></a></div></article>
      </div>
      <aside class="client-start"><h3>Start with the Go client</h3><p>Add the library to your project:</p><div class="command-shell"><pre class="command"><code id="install-command">go get github.com/messier-42/cabe-go</code></pre><button class="copy-button" id="copy-command" type="button" aria-label="Copy Go installation command"><svg class="icon" aria-hidden="true"><use href="#copy"/></svg></button></div><p class="copy-status" id="copy-status" aria-live="polite"></p><p>The example also needs a running CKAP endpoint and a client configured to authenticate to it. Installing the library does not start the key service.</p><a class="more-link" href="https://github.com/messier-42/cabe-go#quick-start" target="_blank" rel="noopener noreferrer">Read the client setup <svg class="icon" aria-hidden="true"><use href="#external"/></svg></a></aside>
    </div>
  </section>

  <section class="section" id="integration" aria-labelledby="integration-title">
    <div class="section-intro"><h2 id="integration-title">Where CABE sits</h2><p>A common envelope need not mean a common identity system, policy language or application. The deployment supplies those choices and the trust relationships between them.</p></div>
    <div class="responsibilities">
      <div><h3>CABE components</h3><dl><div><dt>Client library</dt><dd>Constructs and consumes envelopes; makes key service requests.</dd></div><div><dt>Key service</dt><dd>Manages keys and leases; controls access according to policy.</dd></div><div><dt>Envelope</dt><dd>Binds attributes to the encrypted payload and identifies the lease.</dd></div></dl></div>
      <div><h3>The surrounding system</h3><dl><div><dt>Identity &amp; policy</dt><dd>Establishes caller claims, message attributes and access rules.</dd></div><div><dt>Transport</dt><dd>Delivers and stores envelopes using the available infrastructure.</dd></div><div><dt>Processing</dt><dd>Controls plaintext use, release of derived information and records of use.</dd></div></dl></div>
    </div>
    <details class="note" id="delegated-access"><summary>Requests made on someone else’s behalf <svg class="icon" aria-hidden="true"><use href="#chevron"/></svg></summary><div class="note-body"><p>A service at the end of a chain may recognise its immediate caller without knowing who initiated the task or what authority was delegated. A larger system should be able to make that distinction when deciding whether to release information.</p><p>CABE can provide object protection and policy controlled key access within that system. The integration must validate the delegation and enforce its limits, including where a caller already holds broader key material. The envelope does not itself define a transitive-identity protocol.</p><p>Records can link a task, acting service, object and access decision. With local key use, point-of-use instrumentation is also needed: a key service log is not a log of every object decrypted.</p></div></details>
  </section>

  <section class="section references" aria-label="Technical references">
    <div id="specifications"><h2>Specifications</h2>
      <a class="spec-link" href={`${base}/spec/arch/`}><code>CABE-ARCH</code><span><strong>Architecture</strong><small>Attributes, key series, leases and access.</small></span><svg class="icon" aria-hidden="true"><use href="#external"/></svg></a>
      <a class="spec-link" href={`${base}/spec/cbes/`}><code>CBES</code><span><strong>Envelope structure</strong><small>Message encoding and cryptographic operations.</small></span><svg class="icon" aria-hidden="true"><use href="#external"/></svg></a>
      <a class="spec-link" href={`${base}/spec/ckap/`}><code>CKAP</code><span><strong>Key access protocol</strong><small>Client and key service interaction.</small></span><svg class="icon" aria-hidden="true"><use href="#external"/></svg></a>
      <a class="spec-link" href={`${base}/spec/cfar/`}><code>CFAR</code><span><strong>Federation and resilience</strong><small>Lease packages for prepared receiving domains.</small></span><svg class="icon" aria-hidden="true"><use href="#external"/></svg></a>
      <a class="spec-link" href={`${base}/spec/acp240/`}><code>ACP240</code><span><strong>Attribute mapping</strong><small>A defined subset of classification metadata.</small></span><svg class="icon" aria-hidden="true"><use href="#external"/></svg></a>
      <a class="more-link" href={`${base}/specification/`}>All specification drafts <svg class="icon" aria-hidden="true"><use href="#arrow"/></svg></a>
    </div>
    <div id="security"><h2>Security boundaries</h2>
      <details class="faq"><summary>What happens after a key is disclosed?<svg class="icon" aria-hidden="true"><use href="#chevron"/></svg></summary><p>An exported key can be used locally without another key service decision. A later refusal cannot erase keys or plaintext already obtained. Leases and rollover matter for future messages; separate envelopes sharing usable key material do not automatically have separate access boundaries. <a href={`${base}/spec/arch/`}>Key access and rollover</a></p></details>
      <details class="faq"><summary>Does the payload pass through the key service?<svg class="icon" aria-hidden="true"><use href="#chevron"/></svg></summary><p>No. Non-captive keys are used locally. With captive keys, the service performs operations on a content-encryption key while the application handles the payload; it does not need the whole video segment or file. <a href={`${base}/spec/cbes/`}>Envelope operations</a></p></details>
      <details class="faq"><summary>What does federation require?<svg class="icon" aria-hidden="true"><use href="#chevron"/></svg></summary><p>Prepared trust, the appropriate federation keys and lease package, and the required local services. The current draft specifies early selection of target domains and non-captive lease keys. The receiving key service must be trusted with the material it recovers. <a href={`${base}/spec/cfar/`}>Federation draft</a></p></details>
      <details class="faq"><summary>What does integrity protection establish?<svg class="icon" aria-hidden="true"><use href="#chevron"/></svg></summary><p>Authenticated encryption protects against changes by parties without the required key. It does not distinguish every holder of a shared key, prove an observation is true or establish correct labelling. Producer-specific provenance needs additional evidence. <a href={`${base}/spec/cbes/`}>Envelope protection</a></p></details>
      <details class="faq"><summary>Are the attributes confidential?<svg class="icon" aria-hidden="true"><use href="#chevron"/></svg></summary><p>The baseline envelope’s protected headers are integrity-protected, not encrypted. Account for the metadata exposed by your attribute scheme separately from the confidentiality of the payload. <a href={`${base}/spec/cbes/`}>Envelope headers</a></p></details>
    </div>
  </section>
</div>
</main>
<script>
/* Display behaviour only. Policy decisions on this page are worked examples.
   The hosted simulator is a separate application, loaded only on request. */
(() => {
  'use strict';
  const launch = document.getElementById('load-simulator');
  const panel = document.getElementById('simulator-launch');
  const host = document.getElementById('simulator-host');
  const close = document.getElementById('close-simulator');
  if (launch && panel && host && close) {
    launch.addEventListener('click', () => {
      if (host.querySelector('iframe')) return;
      const frame = document.createElement('iframe');
      frame.src = host.dataset.src!;
      frame.title = 'CABE Policy Simulator';
      frame.referrerPolicy = 'no-referrer';
      // Keep the direct link available if embedding is blocked by the browser.
      host.appendChild(frame);
      panel.hidden = true;
      host.hidden = false;
      launch.setAttribute('aria-expanded', 'true');
      close.focus({ preventScroll: true });
    });
    close.addEventListener('click', () => {
      host.querySelector('iframe')?.remove();
      host.hidden = true;
      panel.hidden = false;
      launch.setAttribute('aria-expanded', 'false');
      launch.focus({ preventScroll: true });
    });
  }

  const copy = document.getElementById('copy-command');
  const command = document.getElementById('install-command');
  const status = document.getElementById('copy-status');
  if (copy && command && status) {
    copy.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText((command.textContent ?? '').trim());
        status.textContent = 'Command copied.';
        copy.setAttribute('aria-label', 'Command copied. Copy again');
      } catch {
        const range = document.createRange();
        range.selectNodeContents(command);
        const selection = window.getSelection();
        if (selection) {
          selection.removeAllRanges();
          selection.addRange(range);
          status.textContent = 'Command selected. Press Ctrl+C or ⌘C to copy.';
        } else {
          status.textContent = 'Select and copy the command above.';
        }
      }
    });
  }
})();

